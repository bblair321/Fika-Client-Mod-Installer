<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta http-equiv="X-UA-Compatible" content="IE=10">
<title>{{APP_NAME}} - Installer</title>
<HTA:APPLICATION ID="Installer" APPLICATIONNAME="{{APP_NAME}} Installer" BORDER="thin" BORDERSTYLE="fixed" CAPTION="yes" ICON="" MAXIMIZEBUTTON="no" MINIMIZEBUTTON="yes" SHOWINTASKBAR="yes" SINGLEINSTANCE="yes" SYSMENU="yes" VERSION="1.0" WINDOWSTATE="normal" SCROLL="no" ERROR="no" WIDTH="900" HEIGHT="700" />
<style>
html, body { width: 100%; height: 100%; margin: 0; padding: 0; overflow: hidden; scrollbar-width: none; -ms-overflow-style: none; }
*::-webkit-scrollbar { display: none; }
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; margin: 0; padding: 0; display: block; overflow: hidden; width: 900px; height: 700px; background: #1a2332 !important; }
.container { background: #1a2332 !important; -webkit-border-radius: 16px; -moz-border-radius: 16px; -ms-border-radius: 16px; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.3); width: 900px !important; height: 700px !important; overflow: hidden; animation: slideIn 0.3s ease-out; border: none; display: flex; flex-direction: column; position: relative; margin: 0; padding: 0; }
@keyframes slideIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
.header { background: transparent; color: white; padding: 30px; padding-top: 50px; text-align: center; height: auto; flex-shrink: 0; position: relative; -webkit-border-radius: 16px 16px 0 0; -moz-border-radius: 16px 16px 0 0; -ms-border-radius: 16px 16px 0 0; border-radius: 16px 16px 0 0; }
.header h1 { font-size: 2.5em; margin-bottom: 10px; font-weight: 700; color: white; }
.subtitle { font-size: 1.1em; opacity: 0.9; color: white; font-weight: 400; }
.content { padding: 40px; background: white; flex: 1; overflow-y: auto; overflow-x: hidden; min-height: 0; margin: 0 0 0 0; -webkit-border-radius: 0 0 16px 16px; -moz-border-radius: 0 0 16px 16px; -ms-border-radius: 0 0 16px 16px; border-radius: 0 0 16px 16px; }
.step { display: none; animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
@keyframes fadeIn { from { opacity: 0; transform: translateX(20px); } to { opacity: 1; transform: translateX(0); } }
.step.active { display: block; }
.step { margin-bottom: 40px; animation: fadeIn 0.3s ease-out; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
.step h2 { font-size: 1.5em; margin-bottom: 20px; color: #333; border-bottom: 2px solid #b45309; padding-bottom: 10px; font-weight: 600; border-radius: 4px; }
.step p { margin-bottom: 20px; color: #666; line-height: 1.6; font-size: 1em; }
.info-box { background: #f8f9fa; border: 1px solid #e0e0e0; padding: 20px; -webkit-border-radius: 6px; -moz-border-radius: 6px; -ms-border-radius: 6px; border-radius: 6px; margin: 20px 0; }
.info-box strong { color: #555; display: block; margin-bottom: 8px; font-size: 0.95em; font-weight: 600; }
.info-box span { color: #333; font-weight: 600; }
.input-group { display: flex; gap: 10px; margin: 20px 0; }
.path-input { flex: 1; padding: 12px 16px; border: 2px solid #e0e0e0; -webkit-border-radius: 6px; -moz-border-radius: 6px; -ms-border-radius: 6px; border-radius: 6px; font-size: 1em; background: white; color: #333; transition: border-color 0.3s; font-family: "Segoe UI", sans-serif; }
.path-input:focus { outline: none; border-color: #b45309; }
.path-input[readonly] { background-color: #f5f5f5; cursor: pointer; }
.btn { padding: 12px 24px; border: none; -webkit-border-radius: 6px; -moz-border-radius: 6px; -ms-border-radius: 6px; border-radius: 6px; font-size: 1em; font-weight: 600; cursor: pointer; transition: all 0.3s; white-space: nowrap; }
.btn-primary { background: #b45309; color: white; }
.btn-primary:hover:not(:disabled) { background: #92400e; }
.btn-primary:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
button.btn-primary { opacity: 1 !important; cursor: pointer !important; }
.btn-secondary { background: #6c757d; color: white; }
.btn-secondary:hover { background: #5a6268; }
.btn-success { background: #28a745; color: white; }
.btn-success:hover { background: #218838; }
.button-group { display: flex; gap: 12px; margin-top: 20px; justify-content: space-between; }
.progress-container { margin: 20px 0; }
.progress-bar { width: 100%; height: 30px; background: #e0e0e0; border-radius: 15px; overflow: hidden; margin-bottom: 10px; }
.progress-fill { height: 100%; background: #b45309; width: 0%; transition: width 0.3s; border-radius: 15px; }
.progress-text { text-align: center; color: #666; font-size: 0.95em; }
.success-icon { font-size: 4em; text-align: center; margin: 20px 0; color: #28a745; font-weight: 300; }
.error-icon { font-size: 4em; text-align: center; margin: 20px 0; color: #dc3545; font-weight: 300; }
.install-path { background: #f8f9fa; padding: 15px; -webkit-border-radius: 6px; -moz-border-radius: 6px; -ms-border-radius: 6px; border-radius: 6px; font-family: "Consolas", "Monaco", "Courier New", monospace; word-break: break-all; margin: 20px 0; border: 1px solid #e0e0e0; color: #333; font-size: 0.9em; }
.step-indicator { display: flex; justify-content: center; gap: 10px; margin-bottom: 30px; align-items: center; }
.step-dot { width: 10px; height: 10px; border-radius: 50%; background: #e0e0e0; transition: all 0.3s; position: relative; }
.step-dot.active { background: #b45309; width: 30px; border-radius: 5px; }
.step-dot.completed { background: #28a745; }
.step-dot.completed::after { content: "✓"; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: white; font-size: 8px; font-weight: bold; }
</style>
</head>
<body style="background: #1a2332; margin: 0; padding: 0; width: 900px; height: 700px;">
<div class="container" style="background: #1a2332 !important; width: 900px !important; height: 700px !important; margin: 0 !important; padding: 0 !important; position: absolute !important; top: 0 !important; left: 0 !important; -webkit-border-radius: 16px !important; -moz-border-radius: 16px !important; -ms-border-radius: 16px !important; border-radius: 16px !important;">
<div class="header"><h1>{{APP_NAME}}</h1><p class="subtitle">Installation Wizard</p></div>
<div class="content">
<div class="step-indicator"><div class="step-dot active" id="dot0"></div><div class="step-dot" id="dot1"></div><div class="step-dot" id="dot2"></div><div class="step-dot" id="dot3"></div></div>
<div id="welcome-step" class="step active"><h2>Welcome</h2><p>Thank you for choosing {{APP_NAME}}. This wizard will guide you through the installation process.</p><div class="info-box" style="-webkit-border-radius: 6px; -moz-border-radius: 6px; -ms-border-radius: 6px; border-radius: 6px;"><strong>Application:</strong> {{APP_NAME}}<br><strong>Package Size:</strong> <span id="packageSize"><script>document.write(formatBytes(parseInt("{{ARCHIVE_SIZE}}", 10) || 0));</script></span></div><div style="text-align: center; margin-top: 30px;"><button class="btn btn-primary" id="welcomeNextBtn" onclick="nextStep()" style="cursor: pointer; opacity: 1; min-width: 150px; -webkit-border-radius: 6px; -moz-border-radius: 6px; -ms-border-radius: 6px; border-radius: 6px;">Continue</button></div></div>
<div id="directory-step" class="step"><h2>Choose Installation Location</h2><p>Please select the destination folder where you would like to install the files.</p><div class="input-group"><input type="text" id="installPath" class="path-input" placeholder="Click Browse to select a folder..." readonly style="-webkit-border-radius: 6px; -moz-border-radius: 6px; -ms-border-radius: 6px; border-radius: 6px;"><button class="btn btn-primary" id="browseBtn" onclick="selectFolder()" style="-webkit-border-radius: 6px; -moz-border-radius: 6px; -ms-border-radius: 6px; border-radius: 6px;">Browse</button></div><div class="button-group"><button class="btn btn-secondary" id="dirBackBtn" onclick="prevStep()" style="-webkit-border-radius: 6px; -moz-border-radius: 6px; -ms-border-radius: 6px; border-radius: 6px;">Back</button><button class="btn btn-primary" id="nextBtn" onclick="nextStep()" disabled style="-webkit-border-radius: 6px; -moz-border-radius: 6px; -ms-border-radius: 6px; border-radius: 6px;">Install</button></div></div>
<div id="installing-step" class="step"><h2>Installing</h2><p style="margin-bottom: 20px;">Please wait while the files are being extracted.</p><div class="progress-container"><div class="progress-bar"><div id="progressFill" class="progress-fill"></div></div><p id="progressText" class="progress-text">Initializing...</p></div><p style="text-align: center; color: #666; margin-top: 16px; font-size: 0.9em; font-style: italic;">This may take a few moments depending on file size.</p></div>
<div id="complete-step" class="step"><h2>Installation Complete</h2><div class="success-icon">✓</div><p style="text-align: center; margin-bottom: 20px; font-size: 1em; color: #333;">All files have been successfully installed to:</p><p class="install-path" id="finalPath" style="-webkit-border-radius: 6px; -moz-border-radius: 6px; -ms-border-radius: 6px; border-radius: 6px;"></p><div class="button-group" style="justify-content: center; margin-top: 30px;"><button class="btn btn-success" onclick="openFolder()" style="-webkit-border-radius: 6px; -moz-border-radius: 6px; -ms-border-radius: 6px; border-radius: 6px;">Open Folder</button><button class="btn btn-primary" onclick="closeInstaller()" style="-webkit-border-radius: 6px; -moz-border-radius: 6px; -ms-border-radius: 6px; border-radius: 6px;">Finish</button></div></div>
<div id="error-step" class="step"><h2>Installation Failed</h2><div class="error-icon">✗</div><p id="errorMessage" style="text-align: center; color: #721c24; font-weight: 400; margin: 20px 0; padding: 15px; background: #f8d7da; -webkit-border-radius: 6px; -moz-border-radius: 6px; -ms-border-radius: 6px; border-radius: 6px; border: 1px solid #f5c6cb; font-size: 0.9em;"></p><div style="text-align: center; margin-top: 30px;"><button class="btn btn-primary" onclick="showStep(1)" style="-webkit-border-radius: 6px; -moz-border-radius: 6px; -ms-border-radius: 6px; border-radius: 6px;">Try Again</button></div></div>
</div></div></div>
<script>
(function () {
  function log(msg) {
    try {
      var fso = new ActiveXObject("Scripting.FileSystemObject");
      var shell = new ActiveXObject("WScript.Shell");
      var temp = shell.ExpandEnvironmentStrings("%TEMP%");
      var path = temp + "\\\\installer-debug.txt";
      var file;
      if (fso.FileExists(path)) {
        file = fso.OpenTextFile(path, 8);
      } else {
        file = fso.CreateTextFile(path, true);
      }
      file.WriteLine(new Date().toISOString() + " | " + msg);
      file.Close();
    } catch (e) {
    }
  }
  window.__log = log;
  window.onerror = function (msg, url, line) {
    log("JS ERROR: " + msg + " @ line " + line);
    return false;
  };
  log("HTA script started");
})();
// Immediately resize window on load to prevent auto-sizing
(function() {
  try {
    window.resizeTo(900, 700);
    var centerX = (screen.availWidth / 2) - 450;
    var centerY = (screen.availHeight / 2) - 350;
    window.moveTo(centerX, centerY);
    document.body.style.backgroundColor = "transparent";
  } catch (e) {}
})();
// Window dragging works with native title bar
window.onload = function() {
  try {
    window.resizeTo(900, 700);
    var centerX = (screen.availWidth / 2) - 450;
    var centerY = (screen.availHeight / 2) - 350;
    window.moveTo(centerX, centerY);
    document.body.style.background = "#1a2332";
    var container = document.querySelector(".container");
    if (container) container.style.background = "#1a2332";
    applyDefaultInstallPath();
  } catch (e) {}
};
function applyDefaultInstallPath() {
  try {
    if (!defaultExtractPath || defaultExtractPath === "{{" + "DEFAULT_EXTRACT_PATH" + "}}") {
      return;
    }
    selectedPath = defaultExtractPath;
    var pathEl = document.getElementById("installPath");
    var btnEl = document.getElementById("nextBtn");
    if (pathEl) pathEl.value = selectedPath;
    if (btnEl) btnEl.disabled = false;
  } catch (e) {}
}
function escapeHtml(value) {
  var s = String(value);
  s = s.split("&").join("&amp;");
  s = s.split("<").join("&lt;");
  s = s.split(">").join("&gt;");
  s = s.split('"').join("&quot;");
  s = s.split("'").join("&#39;");
  return s;
}
function el(tag, className, text) {
  var e = document.createElement(tag);
  if (className) e.className = className;
  if (text !== undefined) e.innerText = text;
  return e;
}
function clear(node) {
  while (node.firstChild) node.removeChild(node.firstChild);
}
function showError(message) {
  __log("UI ERROR: " + message);
  var box = document.getElementById("errorMessage");
  if (box) {
    box.innerText = message;
    box.style.display = "block";
  }
}
var currentStep = 0;
var selectedPath = null;
var finalExtractionPath = null;
var archiveSize = parseInt("{{ARCHIVE_SIZE}}", 10) || 0;
var defaultExtractPath = "{{DEFAULT_EXTRACT_PATH}}";
var commFile = (function() {
  try {
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var shell = new ActiveXObject("WScript.Shell");
    var tmp = shell.ExpandEnvironmentStrings("%TEMP%");
    if (!tmp || tmp === "%TEMP%") {
      tmp = fso.GetSpecialFolder(2);
    }
    if (!tmp) {
      tmp = "C:\\\\Windows\\\\Temp";
    }
    var bs = String.fromCharCode(92);
    var result;
    if (tmp.charAt(tmp.length - 1) === bs) {
      result = tmp + "installer-comm.json";
    } else {
      result = tmp + bs + "installer-comm.json";
    }
    return result;
  } catch (e) {
    return "C:\\\\Windows\\\\Temp\\\\installer-comm.json";
  }
})();
function formatBytes(bytes) {
  if (bytes === 0) return "0 Bytes";
  var k = 1024;
  var sizes = ["Bytes", "KB", "MB", "GB"];
  var i = Math.floor(Math.log(bytes) / Math.log(k));
  return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + " " + sizes[i];
}
function showStep(stepIndex) {
  try {
    var steps = ["welcome-step", "directory-step", "installing-step", "complete-step", "error-step"];
    for (var i = 0; i < steps.length; i++) {
      var el = document.getElementById(steps[i]);
      if (el) {
        if (i === stepIndex) {
          el.className = "step active";
          el.style.display = "block";
        } else {
          el.className = "step";
          el.style.display = "none";
        }
      }
    }
    currentStep = stepIndex;
  } catch (e) {
    alert("Error showing step: " + e.message);
  }
}
function nextStep() {
  try {
    if (currentStep === 0) {
      showStep(1);
    } else if (currentStep === 1) {
      if (!selectedPath) {
        alert("Please select an installation directory first.");
        return;
      }
      startExtraction();
    } else {
      showStep(currentStep + 1);
    }
  } catch (e) {
    alert("Error in nextStep: " + e.message + "\\nStack: " + (e.stack || "no stack"));
  }
}
function prevStep() {
  if (currentStep > 0) showStep(currentStep - 1);
}
function selectFolder() {
  var shell = new ActiveXObject("Shell.Application");
  var folder = shell.BrowseForFolder(0, "Select installation directory:", 0);
  if (folder) {
    selectedPath = folder.Self.Path;
    var pathEl = document.getElementById("installPath");
    var btnEl = document.getElementById("nextBtn");
    if (pathEl) pathEl.value = selectedPath;
    if (btnEl) btnEl.disabled = false;
  }
}
function startExtraction() {
  try {
    if (!selectedPath) {
      alert("Please select an installation folder first.");
      return;
    }
    if (!commFile || commFile === "undefined") {
      alert("An error occurred. Please try again.");
      return;
    }
    showStep(2);
    updateProgress(15, "Preparing extraction...");
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var data = "EXTRACT|" + selectedPath;
    var folder = fso.GetParentFolderName(commFile);
    if (!fso.FolderExists(folder)) {
      fso.CreateFolder(folder);
    }
    var file = fso.CreateTextFile(commFile, true);
    file.Write(data);
    file.Close();
    updateProgress(25, "Extracting files...");
  } catch (e) {
    alert("An error occurred: " + e.message);
    updateProgress(0, "Error: " + e.message);
  }
}
function updateProgress(percentage, text) {
  var fillEl = document.getElementById("progressFill");
  var textEl = document.getElementById("progressText");
  if (fillEl) {
    fillEl.style.width = percentage + "%";
    if (percentage >= 100) {
      fillEl.style.background = "#5A5A5A";
    }
  }
  if (textEl) textEl.textContent = text;
}
function checkExtractionStatus() {
  try {
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    if (fso.FileExists(commFile)) {
      var file = fso.OpenTextFile(commFile, 1);
      var content = file.ReadAll();
      file.Close();
      if (content.indexOf("EXTRACT|") === 0) {
        updateProgress(30, "Extraction in progress...");
        return;
      }
      if (content.indexOf("EXTRACT|") === 0) {
        updateProgress(40, "Extracting files...");
        return;
      }
      if (content.indexOf("COMPLETE|") === 0) {
        var parts = content.split("|");
        if (parts.length >= 3 && parts[2] === "SUCCESS") {
          updateProgress(100, "Installation complete!");
          finalExtractionPath = parts[1];
          setTimeout(function() {
            var pathEl = document.getElementById("finalPath");
            if (pathEl) pathEl.textContent = finalExtractionPath;
            showStep(3);
          }, 800);
        } else {
          var errorEl = document.getElementById("errorMessage");
          if (errorEl) errorEl.textContent = parts.length > 3 ? parts[3] : "An unknown error occurred during installation.";
          showStep(4);
        }
      } else if (content.indexOf("CLOSE") === 0) {
        window.close();
      }
  }
  } catch (e) {
    // Silently handle errors
  }
}
function openFolder() {
  if (finalExtractionPath) {
    var shell = new ActiveXObject("WScript.Shell");
    shell.Run("explorer " + finalExtractionPath);
  }
}
function closeInstaller() {
  var fso = new ActiveXObject("Scripting.FileSystemObject");
  var file = fso.CreateTextFile(commFile, true);
  file.Write("CLOSE");
  file.Close();
  window.close();
}
function initGUI() {
  try {
    showStep(0);
    setInterval(checkExtractionStatus, 500);
    // Resize window to fit content properly
    try {
      window.resizeTo(900, 700);
      window.moveTo((screen.width / 2) - 450, (screen.height / 2) - 350);
    } catch (resizeError) {
      // Ignore resize errors
    }
  } catch (e) {
    // Silently handle errors
  }
}
setTimeout(function() {
  try {
    initGUI();
  } catch (e) {
    // Silently handle errors
  }
}, 100);
</script>
</body></html>